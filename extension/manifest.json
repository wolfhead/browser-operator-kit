{
  "manifest_version": 3,
  "name": "Browser Operator Kit Page Observer",
  "description": "Descriptor-driven page observation, explicit JavaScript inspection, and automation status for Codex.",
  "version": "0.9.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:38492/*",
    "http://127.0.0.1:38493/*"
  ],
  "background": {
    "service_worker": "observer-service-worker.js",
    "type": "module"
  },
  "content_scripts": [],
  "action": {
    "default_title": "打开网页自动化状态板"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
